{
  "cli": {
    "version": ">= 19.0.8",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://navx-backend-f8wa.onrender.com/api"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://navx-backend-f8wa.onrender.com/api"
      },
      "channel": "production"
    },
    "apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "channel": "apk"
    }
  },
  "submit": {
    "production": {}
  }
}
