# NavX Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to source control.

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Authentication Secrets (generate strong random values!) ─────────────────
JWT_SECRET=<generate-a-64-char-random-hex-string>
JWT_REFRESH_SECRET=<generate-another-64-char-random-hex-string>

# ─── SuperAdmin Bootstrap (used only for first-time admin creation) ──────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=<strong-password-min-12-chars>

# ─── Third-Party API Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=<your-google-gemini-api-key>
OPENWEATHER_API_KEY=<your-openweathermap-api-key>

# ─── Admin Panel URL Base ───────────────────────────────────────────────────
ADMIN_URL_BASE=https://admin.navx.com
